# Backend API server (backend/index.ts) — point this at your own Postgres
# instance (local install or otherwise); the database itself must already
# exist (e.g. `createdb linqo`), backend/db.ts only creates the tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linqo
PORT=3001
# Optional trusted reverse proxy IPs/CIDRs, comma-separated. Unset means
# forwarding headers are ignored. Never use true, hop counts or 0.0.0.0/0.
# TRUSTED_PROXIES=10.0.0.10/32
# Optional stable HMAC secret (32+ characters). Without it a shared random
# secret is stored in app_secrets on first use. Keep it the same on all API
# instances and across restarts; rotating it resets rate-limit identities.
# ABUSE_SECRET=
# Comma-separated. Leave unset in dev — any http://localhost:<port> origin
# is allowed automatically since Vite's port shifts around.
# CORS_ORIGIN=https://your-deployed-frontend.example

# Frontend (Vite) — where the browser sends API requests.
VITE_API_URL=http://localhost:3001

# OAuth (Google + GitHub) — optional. The "Continue with Google/GitHub"
# buttons on /login render either way; they just redirect to a friendly
# error until these are filled in. Create the provider apps yourself:
#   Google: console.cloud.google.com -> APIs & Services -> Credentials
#     Authorized JS origin:   http://localhost:3001
#     Authorized redirect URI: http://localhost:3001/api/auth/google/callback
#   GitHub: github.com/settings/developers -> OAuth Apps
#     Homepage URL:      http://localhost:8080 (or whatever port Vite prints)
#     Callback URL:       http://localhost:3001/api/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Where the backend redirects the browser back to after an OAuth callback.
# Vite's dev port hops (8080, 8081, ...) whenever one's already taken —
# check the terminal for the port it actually printed and keep this in sync,
# or the OAuth callback will land on a dead/wrong tab.
FRONTEND_URL=http://localhost:8080

# Backend's own origin — used to build the OAuth redirect_uri above. Only
# needs to change if PORT does, or in production.
# API_BASE_URL=http://localhost:3001

# Password reset emails, via Resend (resend.com). onboarding@resend.dev
# works with no domain verification for dev; switch to a verified sending
# domain's address before deploying.
# RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
